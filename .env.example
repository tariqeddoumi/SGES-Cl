# ==========================================================================
# BASE DE DONNÉES — multi-bases : PostgreSQL (défaut), SQL Server, MySQL, SQLite
# Changer de moteur : npm run db:fournisseur -- sqlserver   (voir docs/bases-de-donnees.md)
# ==========================================================================
# PostgreSQL 14+ (Supabase, hébergé par la banque, Azure, RDS…)
DATABASE_URL="postgresql://sges:motdepasse@localhost:5432/sges?schema=public"
# Supabase partagé avec l'outil de scoring Project Finance : schéma dédié « sges »
# (même mot de passe que l'outil PF ; voir docs/bases-de-donnees.md › Supabase)
# Application (pooler transactionnel, port 6543) :
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[MOT-DE-PASSE]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?schema=sges&pgbouncer=true&connection_limit=1"
# Commandes db:schema / db:importer / db:verifier (pooler de session, port 5432) :
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[MOT-DE-PASSE]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?schema=sges"
# SQL Server :  DATABASE_URL="sqlserver://hote:1433;database=sges;user=sges;password=…;encrypt=true"
# MySQL 8   :  DATABASE_URL="mysql://sges:motdepasse@hote:3306/sges"
# SQLite    :  DATABASE_URL="file:./sges.db"   (démonstration / poste local)

# ==========================================================================
# SÉCURITÉ
# ==========================================================================
# Clé de signature des sessions : 32 caractères aléatoires minimum (obligatoire en production)
JWT_SECRET="remplacer-par-une-cle-aleatoire-de-32-caracteres-min"
# Durée d'une session (heures)
SESSION_HEURES=10

# ==========================================================================
# CONNECTEUR SIGNALÉTIQUE (système central bancaire)
# simulation : jeux d'essai intégrés (INTERDIT en production) ; api : appel HTTP GET {URL}/{compte}
# desactive : saisie manuelle de la fiche client uniquement
# ==========================================================================
SIGNALETIQUE_MODE=simulation
# SIGNALETIQUE_URL=https://t24.banque.local/api/clients
# SIGNALETIQUE_JETON=...
# Recette sur un serveur de production uniquement : autorise explicitement la simulation.
# SIGNALETIQUE_SIMULATION_AUTORISEE=true

# ==========================================================================
# ASSISTANT IA (facultatif) — analyse des pièces, pré-remplissage
# Désactivé par défaut ; activation subordonnée à la référence de validation juridique / CNDP / SSI
# (Paramétrage › IA_REFERENCE_VALIDATION). Les identifiants sont masqués avant envoi.
# ==========================================================================
# ANTHROPIC_API_KEY=sk-ant-...
# Passerelle IA approuvée par la banque (proxy interne, journalisation, filtrage) :
# ANTHROPIC_BASE_URL=https://passerelle-ia.banque.local

# ==========================================================================
# API D'INTÉGRATION (plateforme d'octroi)
# Signature HMAC-SHA256 des fiches restituées (en-tête X-SGES-Signature) ; à défaut, JWT_SECRET.
# ==========================================================================
# API_SIGNATURE_SECRET=...

# ==========================================================================
# MESSAGERIE (facultatif) — notifications au Responsable RSE
# ==========================================================================
# SMTP_URL=smtp://utilisateur:motdepasse@smtp.banque.local:587
# SMTP_EXPEDITEUR=sges@banque.ma
