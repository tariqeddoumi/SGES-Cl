{
  "name": "sges",
  "version": "1.0.0",
  "private": true,
  "description": "SGES — Système de Gestion Environnementale, Sociale et Climatique (risques E&S des crédits d'investissement)",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "db:fournisseur": "tsx scripts/db/fournisseur.ts",
    "db:generate": "prisma generate",
    "db:schema": "prisma db push --skip-generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:reference": "tsx prisma/seed.ts --reference-seulement",
    "db:exporter": "tsx scripts/db/exporter.ts",
    "db:importer": "tsx scripts/db/importer.ts",
    "db:verifier": "tsx scripts/db/verifier.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/postcss": "^4.2.2",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "jose": "^5.10.0",
    "lucide-react": "^1.7.0",
    "next": "^15.5.27",
    "postcss": "^8.5.31",
    "prisma": "^5.22.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "jszip": "^3.10.1",
    "unpdf": "^1.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.11",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.27",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.1.1",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    },
    "uuid": "^11.1.1"
  }
}
